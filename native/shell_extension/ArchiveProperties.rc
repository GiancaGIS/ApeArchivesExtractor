#include <windows.h>
#include "ArchivePropertiesResource.h"

IDD_ARCHIVE_PROPERTIES DIALOGEX 0, 0, 260, 230
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CAPTION
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "APE archive"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_ARCHIVE_STATUS, 8, 8, 244, 20
    EDITTEXT IDC_ARCHIVE_REPORT, 8, 30, 244, 170, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Open archive", IDC_ARCHIVE_OPEN, 8, 208, 112, 14
    PUSHBUTTON "Copy information", IDC_ARCHIVE_COPY, 128, 208, 124, 14
END
